{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://proteus.dev/design-tokens.json",
  "_comment": "Proteus Website v3 — Design Tokens. 唯一事实源，供 LLM/代码生成消费。颜色/字号/间距均为确定值，禁止自由发挥。对齐 01-website-rearchitecture.md 与 index.html 实跑视觉。",
  "version": "3.0.0",

  "color": {
    "bg": "#0a0a0c",
    "panel": "#121216",
    "panel2": "#1a1a20",
    "line": "#26262e",
    "ink": "#f2f2f5",
    "muted": "#8a8a99",
    "dim": "#5c5c6a",
    "brand": "#7c5cff",
    "brandHover": "#6a4cf0",
    "brand2": "#00e0c6",
    "accent": "#ff8a5c",
    "ok": "#3ddc97",
    "warn": "#ffb454",
    "rec": "#ff6b6b",
    "backend": {
      "vue": "#42b883",
      "ios": "#0a84ff",
      "android": "#3ddc84",
      "flutter": "#54c5f8",
      "skia": "#ffd54f",
      "harmony": "#ff8a5c",
      "native": "#7c5cff"
    },
    "syntax": {
      "kw": "#c792ea",
      "tag": "#e06c75",
      "attr": "#d19a66",
      "str": "#98c379",
      "com": "#5c6370",
      "fn": "#61afef",
      "plain": "#a6a6b8",
      "err": "#e05b5b"
    },
    "device": {
      "phoneBg": "#0d1530",
      "tabletBg": "#111c40",
      "pcBg": "#0f1a30",
      "carBg": "#1a1208",
      "tvBg": "#0a1024",
      "watchBg": "#0d0d18",
      "lightInk": "#f6f8fc",
      "muted2": "#7d8590",
      "frameBorder": "#2a365e",
      "appHeader": "#1a2a55",
      "appText": "#1a2238",
      "statusMuted": "#556",
      "sideOn": "#eef3ff",
      "pillBg": "#eef1f8",
      "thumbFrom": "#eef2ff",
      "thumbTo": "#e6fbff",
      "watchMuted": "#889",
      "tvMuted": "#bcd",
      "tvPillMuted": "#cde",
      "cardBg": "#fff",
      "codeKw": "#ff9b73",
      "codeTag": "#7ee787",
      "codeAttr": "#d2a8ff",
      "codeStr": "#a5d6ff",
      "notch": "#000"
    },
    "aux": {
      "tagBrand": "#b6a3ff",
      "hero1": "#1a2a55",
      "hero2": "#1a2238",
      "hero3": "#2a365e",
      "heroInk": "#eef2ff",
      "heroCyan": "#e6fbff",
      "heroMuted": "#c9d3f0"
    }
  },

  "font": {
    "family": "-apple-system, 'SF Pro', 'WenQuanYi Micro Hei', system-ui, sans-serif",
    "mono": "'SF Mono', Menlo, Consolas, monospace",
    "size": {
      "base": "15px",
      "h1": "clamp(34px, 5.4vw, 60px)",
      "h2": "26px",
      "h4": "17px",
      "small": "12px",
      "tag": "11px"
    },
    "lineHeight": "1.6",
    "weight": { "bold": "700", "black": "800" }
  },

  "space": {
    "scale": [0, 4, 5, 6, 8, 10, 12, 14, 16, 18, 22, 24, 26, 28, 30, 40, 60, 72],
    "container": "1180px",
    "radius": { "sm": "4px", "md": "7px", "lg": "9px", "xl": "14px", "pill": "20px", "chip": "6px", "logo": "8px" }
  },

  "layout": {
    "navHeight": "≈60px",
    "breakpointStack": "820px",
    "columns": { "features": 3, "dimensions": 4, "demoGrid": "repeat(auto-fill, minmax(110px, 1fr))" }
  },

  "motion": {
    "transition": "0.15s",
    "blur": "12px"
  },

  "semantic": {
    "gradientText": "linear-gradient(100deg, #7c5cff, #00e0c6)",
    "gradientMark": "conic-gradient(from 180deg, #7c5cff, #00e0c6, #ff8a5c, #7c5cff)"
  },

  "tier": {
    "1": { "label": "Tier 1", "color": "#3ddc97" },
    "2": { "label": "Tier 2", "color": "#ffb454" },
    "3": { "label": "Tier 3", "color": "#54c5f8" },
    "4": { "label": "Tier 4", "color": "#8a8a99" }
  },

  "device": {
    "phone": { "cols": 1, "label": "手机 · portrait · touch" },
    "tablet": { "cols": 2, "label": "平板 · split-view · touch" },
    "pc": { "cols": 3, "label": "PC · desktop · mouse+kb" },
    "car": { "cols": 1, "label": "车机 · dashboard · dpad", "tier": 2 },
    "tv": { "cols": 1, "label": "TV · 10ft · remote", "tier": 2 },
    "watch": { "cols": 1, "label": "手表 · wearable · crown", "tier": 2 }
  }
}
