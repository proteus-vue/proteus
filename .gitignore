# ══════════════════════════════════════════════════════════════════════════
# ★★★构建/调试产物目录（#1136：此前 **186 MB + 26 MB 漏网入库**，clone 体积被撑大）
#
# 【根因（★忽略规则与目录名不匹配 ⇒ 静默失效）】
#   `spike/.gitignore` 写的是 `target/`，而实际 Cargo 目标目录叫 `target-qjs/`
#   （构建时用 `CARGO_TARGET_DIR=spike/target-qjs`）⇒ **规则从未命中** ⇒
#   576 个 .rlib/.rmeta/二进制（186 MB）全被跟踪。
#   ★这是"忽略规则要认真实目录名"的实例：写成 `target/` 看起来对、实际一个都没拦。
#
# 【为什么放在**根** .gitignore 而不是子目录】子目录规则容易被后续 `CARGO_TARGET_DIR`
#   改名再次失配；放在根 + 用 `**/` 通配，改名也能覆盖。
#
# ⚠ 注意与"有意入库"的产物区分（这些**保留**）：
#   · `packages/cli/templates-host/prebuilt/**` —— CLI 随包发布的预编译运行时（产品要的）
#   · `hosts/{android,ios,harmony}/results/**` —— 真机判据证据（项目纪律要求入库）
spike/target-qjs/
**/target-qjs/
# CDP 调试截图（website/cdp-*.mjs 的**产出**，151 张 PNG / 26 MB；无任何消费方）
.cdp-shots/

# ★★WorkBuddy 抢救区（2026-10-20 · #1147）
#   【它是什么】真机视觉迭代过程的**中间草稿**：每轮截图/差异图/渲染脚本，实测 **5447 个文件 · 6.0 GB**
#     （5413 PNG + 69 py + 17 npy + 10 mp4…），与 .cdp-shots 同族（调试产出，无程序消费方）。
#   【为什么要忽略】它让 git status 常驻 5450 条未跟踪项，且 test:coupled 用
#     `git ls-files --others --exclude-standard` 统计"改动文件" ⇒ 实测报「改动 **5464** 个文件」
#     ⇒ 配套断言表的精化匹配**永远命中不了**（工具退化为"无命中"）。这不是噪音，是功能失效。
#   ★**已入库的 106 个文件不受影响**（gitignore 不作用于已跟踪文件）：它们是**被 docs/ai-tasks.json
#     的 verification 字段引用**的验收证据（liquid-glass 的 13 个编号目录 + 若干对照图）。
#   ★**以后新增验收证据**：`git add -f <path>`（机器判据见 scripts/check-evidence-tracked.mjs
#     第 ② 组——它解析 ai-tasks.json 的 salvage 引用，断言"存在且已入库"，漏加会当场红）。
#   ⇒ 忽略的是**草稿**，不是**证据**；两者的判据在门禁里，不靠自觉。
.workbuddy/salvage/

# Python 字节码缓存（脚本自测产生；不入库）
__pycache__/

# 临时探针目录（调试用；断言已固化进 tests/ 与 scripts/vapor-capability-probe.mts）
.tmp-probe/
# ★导航丝滑演示录屏**原片**（9.5MB）——规范同 morpheus-* 系列：交付物是裁切后的正片
#   hosts/android/results/nav-router-fast-switch.mp4（2.4MB，已在库）；原片留本机复跑用
hosts/android/results/nav-router-raw.mp4

# ★★真机 TLS / h2 探针的自签证书与私钥（每轮由 openssl 现生成，**不得入库**）
#   【为什么】`check:secret-scan` 把 `*.key` 判为敏感凭据；且 runner 每轮 `rm -f *.crt *.key` 后重新生成
#     ⇒ 入库的证书与下一轮私钥**必然不配对**，留着只会误导（真机读数在 transport-probe.json / tls-probe.json）。
#   ★这是 #1154 的遗留（当时把证书连证据一起提交）——#1155 由 `check:secret-scan` 抓出。
hosts/*/results/*-certs/*.key
hosts/*/results/*-certs/*.crt
hosts/*/results/*-certs/args.json
# ★#1404：压测脚本的**单轮中间产物**（每轮一份 raw，仅用于取中位后即删）。
#   入库的是取中位后的 perf-probe.json；raw 只是过程件，混进结果目录会让人误当证据。
hosts/*/results/perf-probe-raw*.json
