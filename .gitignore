# 依赖
node_modules/

# 构建产物（小程序 / Web 均为编译产物，不入库）
dist/
.vite/

# 测试与覆盖率
coverage/
*.tsbuildinfo

# 日志与系统文件
*.log
.DS_Store

# 环境变量（含 AppID 等敏感信息）
.env
.env.*
!.env.example
.proteus/

# 本地 Agent 会话状态（含 plan 文件——非项目源码）
.zcode/

# local npm auth (never commit)
.npmrc
scripts/commit-msg.txt
popover-open.png

# 本地工具缓存（scripts/check-publish-drift.mjs 的 pack/判定缓存）
.cache/
# hosts：原生宿主构建产物（bundle.js 已被 dist/ 规则覆盖）
# ★Android 侧 IIFE bundle 的**拷贝**（源在 hosts/android/bridge/dist/，已被 dist/ 覆盖）
#   ⇒ 由 build-and-run.sh 在构建时自动生成（见其步骤 ②.5），**不入库**（避免"两份副本漂移"）
hosts/android/app/src/main/assets/bundle-batch.js
# ★M5 路由虚拟栈 bundle 的拷贝（源 hosts/android/bridge/dist/bundle-app-stack.js；同款规则同款理由）
hosts/android/app/src/main/assets/bundle-app-stack.js
# ★G-39 宿主运行时 bundle 的拷贝（源 hosts/android/bridge/dist/bundle-host-runtime.js；同款规则同款理由）
hosts/android/app/src/main/assets/bundle-host-runtime.js
# ★灯光秀 bundle 的拷贝（源 hosts/android/bridge/dist/bundle-lights.js；同款规则同款理由）
hosts/android/app/src/main/assets/bundle-lights.js
# ★灯光秀录屏原片（43MB）——与 iOS showcase.mp4 同款：网页交付物是正片
#   website/public/morpheus-lights.mp4（6.6MB，已在库）；原片留本机复跑用
hosts/android/results/lights-demo.mp4
hosts/android/results/lights.mp4
# ★维度折叠录屏原片（38MB）——同款：网页交付物是 website/public/morpheus-flip.mp4（4MB）
hosts/android/results/flip-demo.mp4
hosts/**/build/
# ★iOS 侧的**具名**构建目录（build-sim / build-l4 / build-l4-device）——非 `build/` 形态，
#   逐个漏忽略（2026-10-02 加 l4-device 时才发现 build-sim 也一直没被覆盖）⇒ 用通配一次覆盖。
hosts/ios/build-*/
hosts/**/*.app/
hosts/**/verify-jsc
# 实验构建产物与**单次运行**原始数据（本机产物）
hosts/ios/experiments/build/
hosts/ios/experiments/results/experiments.json
hosts/ios/experiments/results/run*.json
# ★但 summary.json 入库：它是「4 次重跑中位」的权威汇总，是文档数字的证据（同 stats.ts 的定位）
# 真机单次运行原始数据（同模拟器侧：只入库 summary.json）
hosts/ios/experiments/device/results/device*.json
hosts/ios/experiments/device/build/
hosts/ios/experiments/device/.provision-work/
hosts/ios/experiments/device/results/mem-*.json
hosts/ios/experiments/device/results/memory-isolated.txt

# ★本地工具链（JDK / NDK 等大体积工具，保持在 data1，不入库）
.tools/

# V3 端到端测试的临时输入（运行时生成，不入库）
tests/.tmp-ops.bin
tests/.tmp-tree.json

# 桩测指纹标记（本地状态：表示"当前源码指纹已通过桩测"；随源码变，不该入库）
hosts/android/.acceptance-stub-ok

# 设备控制台日志（XPC 噪音，非判据；证据在 paint-hint-summary.txt 与 JSON 读数里）
hosts/ios/results/paint-hint-*.log
# ★炫技场录屏**原片**（ReplayKit 逐帧无损，~40MB）——只是转码中间物；
#   网页交付物是 website/public/morpheus-showcase.mp4（3MB，见 hosts/ios/make-showcase-video.sh）
hosts/ios/results/showcase.mp4

# Python 字节码缓存（脚本自测产生；不入库）
__pycache__/

# 临时探针目录（调试用；断言已固化进 tests/ 与 scripts/vapor-capability-probe.mts）
.tmp-probe/
