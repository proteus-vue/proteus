{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "./shims/mp.d.ts", "./shims/events.d.ts", "./shims/vue.d.ts"],
    "baseUrl": ".",
    "paths": {
      "@proteus-vue/components": ["../src/components/index.ts"],
      "@proteus-vue/components/*": ["../src/components/*"],
      "@proteus-vue/shared": ["../packages/shared/src/index.ts"],
      "@proteus-vue/glass": ["../packages/glass/src/index.ts"],
      "@proteus-vue/worklet": ["../packages/worklet/src/index.ts"],
      "@proteus-vue/api": ["../packages/api/src/index.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "pages/**/*.vue",
    "router/**/*.ts",
    "router/**/*.vue",
    "components/**/*.vue",
    "styles/**/*.ts",
    "main.ts",
    "main.mp.ts",
    "App.vue",
    "app.config.ts",
    "shims/**/*.d.ts",
    "../src/components/**/*.d.ts",
    "proteus.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
