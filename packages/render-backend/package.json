{
  "name": "@proteus-vue/render-backend",
  "version": "0.3.0-beta.21",
  "description": "G-27 ProteusRenderBackend SPI：可插拔渲染后端接口 + conformance test + 官方后端原型（Headless/VueDom） + G-41 nodeOps Dispatcher——Render anywhere, on any engine（M1.4）",
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "@proteus-vue/animation": "0.3.0-beta.22",
    "@proteus-vue/component-ir": "0.3.0-beta.21",
    "@proteus-vue/contracts": "0.3.0-beta.11",
    "@proteus-vue/router": "0.3.0-beta.21"
  },
  "peerDependencies": {
    "@vue/runtime-core": "^3.4.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./app-navigation": {
      "types": "./dist/app-navigation.d.ts",
      "import": "./dist/app-navigation.js",
      "default": "./dist/app-navigation.js"
    },
    "./screen-executor": {
      "types": "./dist/screen-executor.d.ts",
      "import": "./dist/screen-executor.js",
      "default": "./dist/screen-executor.js"
    },
    "./screen-executor-host": {
      "types": "./dist/screen-executor-host.d.ts",
      "import": "./dist/screen-executor-host.js",
      "default": "./dist/screen-executor-host.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts src/app-navigation.ts src/screen-executor.ts src/screen-executor-host.ts --bundle --format=esm --platform=neutral --outdir=dist --external:@vue/runtime-core"
  }
}
