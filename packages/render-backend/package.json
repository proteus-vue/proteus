{
  "name": "@proteus-vue/render-backend",
  "version": "0.1.0",
  "description": "G-27 ProteusRenderBackend SPI：可插拔渲染后端接口 + conformance test + 官方后端原型（Headless/VueDom）——Render anywhere, on any engine（M1.4）",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js"
  }
}
