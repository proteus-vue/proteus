<?xml version="1.0" encoding="utf-8"?>
<!-- {{appName}} —— Proteus 最小 Android 宿主（CLI 生成）
     ★包名与 runtime AAR 一致（dev.proteus.layoutcore）⇒ 同包访问，零可见性改动。
     ★★★身份字段（package / label / versionCode / versionName / uses-sdk）
       由 `proteus create host` 与 `proteus build`（target=android，package）从项目
       `proteus.config` 的 `native` 段填充（决策 #635）——手改这里只在项目未声明时生效。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="{{bundleName}}"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <application
        android:label="{{appName}}"
        android:debuggable="true"
        android:allowBackup="false"
        android:hasCode="true">
        <!-- 起始页名（native.android.launchPage 注入点；运行期壳由 JS 注册表决定落地页，此为兜底/兼容） -->
        <meta-data android:name="ProteusHomePage" android:value="index" />
        <!-- ★activity 用 **FQN**（不是相对名 .AppActivity）：这样 manifest 的 `package`（applicationId）
             可与宿主类所在包解耦——`native.android.applicationId` 换包后仍能解析到
             dev.proteus.layoutcore.AppActivity（运行期类仍由 runtime AAR 提供）。 -->
        <!-- ★★★主题：`Theme.Material.Light.NoActionBar`（**Light** 变体 + 与 hosts 壳宿主 SuperappActivity 一致）；
             此前用 `Theme.NoTitleBar.Fullscreen`（旧平台主题：theme 级 `windowFullscreen=true` + 黑
             windowBackground），与运行期 `setDecorFitsSystemWindows(false)`（edge-to-edge）冲突 ⇒
             **状态栏与底部导航区渲染为默认黑色**（用户实测：CLI 宿主看得到黑边，而壳宿主透明）。
             ★★`Theme.Material.NoActionBar`（**深色**变体）的 `windowBackground` 是深色 ⇒ **启动窗口**
             （`onCreate` 之前的主题底，运行期 `setBackgroundDrawable` 管不到）会**闪黑一下**（决策 #724
             用户实测"安卓启动打开黑屏一下"）⇒ 用 **Light** 变体（浅色 windowBackground），与页面/占位层同族。
             透明/edge-to-edge 由运行期设置（`setStatusBarColor`/`setNavigationBarColor`(TRANSPARENT) +
             `setDecorFitsSystemWindows(false)`），主题只需**不带 ActionBar、不强制全屏、浅色底**。 -->
        <activity
            android:name="dev.proteus.layoutcore.AppActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
