{
  "name": "@proteus/cli",
  "version": "0.2.0",
  "description": "Proteus 命令行：proteus build（独立编译）/ explain（决策 trace + AI 说明书）/ rules（规则目录）",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "proteus": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:@vue/compiler-sfc --external:@vue/compiler-dom --external:@proteus/router --external:@proteus/module --external:esbuild --banner:js=\"#!/usr/bin/env node\""
  },
  "dependencies": {
    "@proteus/compiler": "0.2.0",
    "@proteus/module": "0.1.0",
    "@proteus/router": "0.1.0"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/compiler-dom": "^3.5.42"
  }
}
