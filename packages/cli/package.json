{
  "name": "@proteus-vue/cli",
  "version": "0.2.1-beta.0",
  "description": "Proteus 命令行：proteus build（独立编译）/ explain（决策 trace + AI 说明书）/ rules（规则目录）",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "proteus": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:@vue/compiler-sfc --external:@vue/compiler-dom --external:@proteus-vue/router --external:@proteus-vue/module --external:@proteus-vue/compiler --external:@proteus-vue/capabilities --external:@proteus-vue/css-compat --external:@proteus-vue/runtime --external:@proteus-vue/app-config --external:@proteus-vue/devtools-runtime --external:esbuild --banner:js=\"#!/usr/bin/env node\""
  },
  "dependencies": {
    "@proteus-vue/app-config": "0.1.0",
    "@proteus-vue/capabilities": "0.1.0",
    "@proteus-vue/component-ir": "0.1.0",
    "@proteus-vue/compiler": "0.3.0-beta.0",
    "@proteus-vue/css-compat": "0.1.0",
    "@proteus-vue/devtools-runtime": "0.1.0",
    "@proteus-vue/fluid": "0.1.0",
    "@proteus-vue/module": "0.1.0",
    "@proteus-vue/router": "0.2.0-beta.0",
    "@proteus-vue/runtime": "0.2.0-beta.0",
    "@proteus-vue/types": "0.1.0",
    "@proteus-vue/compiler-backend": "0.1.0"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/compiler-dom": "^3.5.42"
  }
}
