{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proteus 应用：一份标准 Vue 源码 → Web + 微信小程序（Skyline）",
  "scripts": {
    "dev:web": "vite --mode web",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "dev:mp": "tsx scripts/gen-routes-cli.ts && vite --mode mp-weixin",
    "build:mp": "tsx scripts/gen-routes-cli.ts && vue-tsc --noEmit && vite build --mode mp-weixin",
    "debug:mp": "PROTEUS_DEBUG=1 npm run build:mp",
    "proteus": "npx proteus"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@proteus/compiler": "^0.1.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
