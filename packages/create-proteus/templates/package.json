{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proteus 应用：一份标准 Vue 源码 → Web + 微信小程序（Skyline）",
  "scripts": {
    "dev:web": "proteus dev --target web",
    "build:web": "proteus build --target web",
    "dev:mp": "proteus dev --target skyline",
    "build:mp": "proteus build --target skyline",
    "debug:mp": "PROTEUS_DEBUG=1 proteus build --target skyline",
    "dev:android": "proteus dev --target android",
    "build:android": "proteus build --target android",
    "package:android": "proteus build --target android --package",
    "dev:ios": "proteus dev --target ios",
    "build:ios": "proteus build --target ios",
    "package:ios": "proteus build --target ios --package",
    "dev:harmony": "proteus dev --target harmony",
    "build:harmony": "proteus build --target harmony",
    "package:harmony": "proteus build --target harmony --package",
    "proteus": "proteus"
  },
  "dependencies": {
    "@proteus-vue/router": "0.3.0-beta.28",
    "@proteus-vue/runtime": "0.3.0-beta.28",
    "@proteus-vue/shared": "0.3.0-beta.28",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@proteus-vue/cli": "0.3.0-beta.31",
    "@proteus-vue/compiler": "0.3.0-beta.31",
    "@proteus-vue/devtools-runtime": "0.3.0-beta.28",
    "@proteus-vue/plugin-vite": "0.3.0-beta.31",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
