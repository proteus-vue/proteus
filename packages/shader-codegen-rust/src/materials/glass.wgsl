// packages/shader-codegen-rust/src/materials/glass.wgsl
// ★★★液态玻璃材质 —— **框架唯一的算法真源**（决策 #834）。
//
// 【这份 WGSL 是什么】它是「液态玻璃」算法**唯一的一份实现**。各端不再各写一份着色器：
//   由 Rust（naga）把本文件落成 iOS Metal(MSL) 与 Android AGSL（GLSL-ES-3.10 方言）；鸿蒙同源落地。
//   观感 = 依 `GlassSpec`（blur/tint/radius/saturation）+ 本算法。参数由内核 `LStyle.glass` 透传。
//
// 【算法模型（= 决策 #825/#827 的"边缘倒角厚板"）】中心平坦（不折射）、仅最外倒角带折射
//   （沿外法线把边界外内容卷进来）、模糊按离边距离键控（边缘锐/中心糊）、去饱和+磨砂白、Fresnel 高光。
//
// 【接口契约（宿主必须满足）】
//   · **渲染目标 = 节点盒**；片元用 `@builtin(position)` 拿**渲染目标像素坐标** frag.xy，
//     减去 `origin`（节点盒在渲染目标内的左上角）⇒ 盒内像素坐标 local = frag.xy - origin，
//     uv = local / size_px。★这样两端统一：Metal 离屏渲染节点盒（origin=0,0）；AGSL 直接画进主画布
//     （origin=节点在画布中的左上角）——同一份算法、只在 uniform 里换 origin。
//   · 纹理 `backdrop`：节点盒**外扩 padding** 后的背景（供边缘折射采到盒外内容）；
//     `tex_scale`/`tex_bias` 把节点 uv 映射到该纹理 uv：sample_uv = uv * tex_scale + tex_bias。
//   · `size_px`：节点盒在**设备像素**下的尺寸（用于 SDF/模糊的 px 量纲）。
//   · uniform 布局见 src/materials/mod.rs 的 `GlassUniforms`（#[repr(C)]，字节偏移已钉）。
//
// 【★改这里 = 改全端】禁止在任何宿主再手写玻璃着色器（门禁 check:shader-capability 会咬）。

@group(0) @binding(0) var backdrop_tex: texture_2d<f32>;
@group(0) @binding(1) var backdrop_smp: sampler;

struct GlassUniforms {
    tint: vec4<f32>,          // 0  着色 RGBA（内核算好的 #RRGGBBAA 归一）
    size_px: vec2<f32>,       // 16 节点盒尺寸（设备像素）
    origin: vec2<f32>,        // 24 节点盒在渲染目标内的左上角（设备像素；Metal=0，AGSL=c.x/c.y）
    tex_bias: vec2<f32>,      // 32 节点uv→纹理uv 的偏置
    tex_scale: vec2<f32>,     // 40 节点uv→纹理uv 的缩放
    light_dir: vec2<f32>,     // 48 光照方向（归一）
    radius: f32,              // 56 圆角（设备像素）
    blur: f32,                // 60 模糊半径（设备像素）
    refract_depth: f32,       // 64 边缘峰值位移（设备像素）
    specular: f32,            // 68 镜面高光强度
    saturation: f32,          // 72 饱和（1=中性）
    // ★★★决策 #911：**区域背景亮度**（0..1）——宿主统计玻璃盒（含 pad）区域的**平均亮度**。
    //   【为什么需要（对齐 iOS `.regular`）】iOS「each layer continuously adapts based on what's behind it」/
    //   「flip from light to dark based on the background」⇒ 玻璃的**明暗基调随整块背景切换**（浅霜/深霜），
    //   而非只与"该像素正后方"有关（那是 #908/#910 的逐像素形态，缺"区域"这一级）。
    //   ★**零布局变更**：本槽原为 `_pad`（闲置对齐填充，三端都设 0）⇒ 直接语义化复用，结构仍 96B。
    bg_lum: f32,              // 76 区域背景亮度（0..1；宿主统计；缺省 0 = 视作深底）
    // ★★★决策 #905：**触控形变**（对齐 Apple `UIGlassEffect.isInteractive`）——点按/拖动时
    //   玻璃在触点处产生液态流动（局部凸起 + 折射被"推"开 + 触点高光增强），松手回弹。
    touch: vec2<f32>,         // 80 触点在**玻璃盒局部设备像素**（未激活 = (-1e6,-1e6)）
    press: f32,               // 88 按压强度 0..1（host 逐帧 lerp 动画）
    overlay: f32,             // 92 ★#952：选中胶囊**叠加层**强度（0=无 / 1=叠半透明中性色：light→灰 · dark→亮；**不动面纱 α**）
    // ★★★决策 #1004：**内层/预模糊模式**（0=外层·宿主锐背板 / 1=内层·锐背板 / 2=外层·宿主已预模糊 / 3=内层·复合帧）。
    //   【为什么（用户：「选中胶囊反而更白，和 iOS 相反」+「不是只有两种切换」+「玻璃下文字有重影」）】
    //   ① **双层霜叠加**：#979 让内层胶囊采样"已含条白霜的复合帧"，但胶囊自己又叠了一层满霜（VEIL_A0，
    //      浅端 0.85）⇒ 内容透射≈0（实测胶囊恒色 (218,216,222) 不随背景变）、且条判暗档透彩 /
    //      胶囊判亮档白霜 ⇒ **条与胶囊两态判定分裂**（用户「不是只有两种切换」）。⇒ 内层（nest=1/3）
    //      **跳过自己的面纱**——输入已含外层霜，只保留 overlay 叠加与边缘光学。
    //   ② **重影**：稀疏 9-tap 的 tap 间距 d=6.24px > 文字笔画宽（~4px @3x）⇒ 笔画被"复制"成
    //      主图 ± 副图（剖面 0.5/1.0/0.5 三段）⇒ 文字读作"重影"。⇒ 宿主先把背板做**连续**预模糊
    //      （box2×3 ⊗ tent16 ⊗ tent8 ⇒ 实测 σ≈3.9px，见 ProteusHostView 深链），shader 只做
    //      **小残差 tap**（d=2.5px < 笔画宽 ⇒ 副本重叠、剖面与理想高斯逐点偏差 ≤0.02，仿真实证）。
    //   【分档（保持总 σ≈0.113·blur 不变）】
    //     · 0/1（锐背板，iOS/鸿蒙现状）⇒ d = blur·0.16（= #1003 口径，逐像素不变）
    //     · 2（外层·预模糊 σ_pre≈3.9px）⇒ d = blur·0.065（= 2.5px @blur39；残差 σ ≈ 1.8px）
    //     · 3（内层·复合帧——已被外层 blur 过）⇒ d = blur·0.04（仅补轻微柔化）
    //   ★nest=0 时本字段所有分支逐像素等价（老资产/旧宿主零回归）。见 决策 #1004。
    nest: f32,                // 96 内层/预模糊模式（见上；0=默认）
};
@group(0) @binding(2) var<uniform> u: GlassUniforms;

// 圆角矩形 SDF（真欧氏距离；内部为负）
fn sd_round_rect(p: vec2<f32>, hs: vec2<f32>, r: f32) -> f32 {
    let q = abs(p) - hs + vec2<f32>(r, r);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2<f32>(0.0, 0.0))) - r;
}

// 圆弧倒角映射（Kyant）：x=0 外缘 → 0，x=1 内侧 → 1
fn circle_map(x: f32) -> f32 {
    return 1.0 - sqrt(max(1.0 - x * x, 0.0));
}

// 按节点uv 采样背景（经 tex_scale/tex_bias 映射到纹理uv）
fn sample_backdrop(uv: vec2<f32>) -> vec4<f32> {
    return textureSample(backdrop_tex, backdrop_smp, uv * u.tex_scale + u.tex_bias);
}

// ★★★决策 #971（对齐 workbuddy 09:05 双场景取证 + iOS 18:53/17:45 实拍）：**按下不做 SDF 轮廓形变**。
//   ★取证订正：iOS 按下时**玻璃条的上下两条边保持原位、平直贯穿**（镜面边线穿过透镜仍连续可见）；
//     外凸（鼓出条外）的是**选中胶囊自己的透镜**（纵向膨胀），两者是**叠加/穿越**关系，**无 smooth-min 颈部**。
//     ⇒ #969 的「轮廓内陷（凹口）」方向错误（会在条上凹出两个坑）；#966 的「宿主 inflatedPillPath 充气剪影」也是错的机制。
//   ★新模型：**形状变化全部来自几何（条静止 + 胶囊盒纵向鼓起，见宿主 drawGlassPass）**，SDF 恒为圆角矩形；
//     shader 侧只剩「亮环沿轮廓」（press_rim）——胶囊的透镜轮廓由**它自己的盒**给出。
@fragment
fn fs_glass(@builtin(position) frag: vec4<f32>) -> @location(0) vec4<f32> {
    let local = frag.xy - u.origin;      // 盒内像素坐标（origin = 节点盒左上角）
    let hs = u.size_px * 0.5;
    let p = local - hs;
    let r = min(u.radius, min(hs.x, hs.y));
    let hsmin = min(hs.x, hs.y);
    // ★★★决策 #972：**按下 × 选中项** 的门控（条 overlay=0 ⇒ 恒 0，按下不影响条）。多处复用（面纱/色散/叠加/亮环）。
    let pr_ov = clamp(u.press, 0.0, 1.0) * clamp(u.overlay, 0.0, 1.0);
    // ★#971：SDF 恒为（当前盒的）圆角矩形——条盒未变 ⇒ 条边平直不动；胶囊盒已纵向放大 ⇒ 透镜轮廓。
    let sd = sd_round_rect(p, hs, r);
    let d = max(-sd, 0.0);               // 离边深度（内部为正）
    let smin = min(u.size_px.x, u.size_px.y);   // 最短**边**（= 2×hsmin）
    // ★★★决策 #907/#910：折射带 ≈ **最短边 1/3**（= 条高 1/3）。
    //   ★#910 修正口径（报告 G3）：原 `hsmin*0.33 = 0.165·min` 实为**最短边的 1/6**（注释称"1/3"、
    //   代码只有一半 ⇒ 带宽被砍半 ⇒ 真机"折射区比 iOS 少很多"）。改 `0.33·min` ⇒ 带宽 **×2**，与注释/iOS 实测一致。
    let band = max(smin * 0.45, 6.0);   // ★★★决策 #1006：0.62→**0.45×最短边**（+ ER 1.90→1.20，见下）
                                       //   【复核修正（workbuddy v3-1016 + 本会话独立复测）】#1005 的 0.62/1.90
                                       //   把折叠镜面推到 ≈0.38·H ⇒ 中腹内容被折成**可见副本**（刻度尺探针实证）。
                                       //   但 iOS 实拍无此现象：09:46 截图「潮汐」ghost（d=68-110px）在上内带
                                       //   **没有镜像副本**（21x 极限拉伸 + 翻转对照双查）；而 workbuddy 帧实测
                                       //   「边缘 ~30px 斜坡压缩比升到极大」。⇒ 折叠镜面应 ≈**0.17·H（≈29px）**：
                                       //   此深度下的镜像副本只出现在贴边 <58px 带内、且 d>58 的内容镜像出条（不可见）
                                       //   ——与全部观测一致。计算：bend(0)=0.33·min·1.2=0.40·min（采样覆盖中腹上半）、
                                       //   s_min = (1−1/√(3·1.2·0.733))·0.45 ≈ **0.17·min**（薄折叠贴边带）。
                                       //   ⇒ "上边内侧的文字"实证为**真实列表行**（OffScreen 副标题）跨缘压缩显示，非镜像副本。
    let e = clamp(d / band, 0.0, 1.0);   // 0=最外缘, 1=内侧（带内）

    // ① 外法线（SDF 梯度；宽 eps 防药丸中轴裂缝）
    let eps = clamp(band * 0.3, 1.0, 16.0);
    // ★#968：法线取**原轮廓**的梯度（内容不动——充气不改法线，否则折射把下面内容挤弯）。
    let g = vec2<f32>(
        sd_round_rect(p + vec2<f32>(eps, 0.0), hs, r) - sd_round_rect(p - vec2<f32>(eps, 0.0), hs, r),
        sd_round_rect(p + vec2<f32>(0.0, eps), hs, r) - sd_round_rect(p - vec2<f32>(0.0, eps), hs, r));
    let n = g / max(length(g), 1e-5);

    // ② 位移场（透镜弯曲）：**位移横贯整个边缘带**（峰值在外缘、向中心平滑归零，中心平坦）。
    //   ★#907 关键修正：旧式 `bend *= smoothstep(1.0, 0.75, e)`（内缘淡出）把位移**只留在带的外侧一小段**
    //     ⇒ 可见位移仅 ~4px（"液态感消失"的真凶）。Apple 的位移横贯整带（带内到处可见压缩漩涡）。
    //   ⇒ 改用 `prof = 1 - smoothstep(0,1,e)`（带外缘 1 → 带内缘 0，S 形平滑覆盖**整带**，两端 C1）。
    //     位移峰值 = 带宽 × 0.45（与带同尺度 ⇒ 自洽，不再依赖宿主传入的 refract_depth 数值）。
    let ec = clamp(e, 0.004, 0.996);
    let u1 = 1.0 - ec;
    let slope = u1 / sqrt(max(1.0 - u1 * u1, 1e-4));
    // ★★★决策 #924（依据 iOS 逆向调研 .workbuddy/memory/2026-10-14.md §逆向结论）：
    //   iOS 核心 shader **仅 4 入参**（backdrop / sdf / ref_height 带高 / ref_length 位移），位移 = 沿边缘法线的
    //   **线性映射**；三种模式由 **ref_length/ref_height 比值**决定 —— <1 凹(缩小) / >1 凸(放大) / ≈1+ **边缘反射(镜像)**
    //   （文章注明：**苹果 GUI 最常用 = 边缘反射**）。⇒ 剖面改**线性**（不再是 (1-e)^3 的自造曲线）。
    // ★★★决策 #991（用户：「做成 iOS 内侧一圈那种折射带」）：剖面 **铺满整带**——`(1−e)³` 只在最外缘
    //   (≈2px) 有位移 ⇒ 上下边几乎无折射（实测 α=0 纯折射时网格笔直穿过、只左右圆角端略弯）。
    //   ⇒ 改 `1 - smoothstep(0,1,e)`（带外缘 1 → 带内缘 0，S 形覆盖**整带**）⇒ 靠四边**一整圈**连续变形。
    //   ★#995（用户「文字没折射、只有按钮边折射」）：`1-smoothstep` 在带外**归零** ⇒ 中腹文字（在带外）
    //     零位移。iOS 实测**中腹也有弱折射**（gradY 上带 1.99 / 中腹 0.90 ≈ 45%）。⇒ 加**中腹基线** 0.45：
    //     边缘 `1-smoothstep` 陡升到 1（窄强圈），带外恒定 0.45（中腹弱折射，覆盖整条）⇒ 处处有折射。
    // ★★★决策 #1010（**撤回 #1009 的剖面改动，恢复 #998/#928 的 (1−e)³ + ER=1.20**——用户「折射和边缘反射都消失了」）：
    //   【#1009 的诊断错误（数学复核证伪）】#1009 称 "(1−e)³ 非单调 ⇒ 折叠"。**错在漏了符号**：
    //     s(d) = d − bend(d)，bend = (1−e)³·band·ER·str ⇒ bend'(d) = −3(1−e)²·ER·str < 0
    //     ⇒ **s'(d) = 1 − bend'(d) = 1 + 3(1−e)²·ER·str > 0 恒成立 ⇒ 既无折叠、也永不越界失控**（对任意 ER）。
    //   【"y=3 处多出的线"的真相】刻度尺探针里那条线 = **源 q=−60（条外上方内容）被采进来** ⇒ 显示深度 0 采到
    //     条外 66px 处内容、24px 内把条外 ~66px 内容压入 —— **这正是 #998 要的"边缘倒影/吸入"本体**（信号不是 bug）。
    //     #1009 把它误判为"折叠副本"，删掉后边缘折射/反射**肉眼消失**（用户实测）。
    //   【恢复】剖面回 `(1−e)³`、ER 回 **1.20**（= #1006 用户验收「折射终于对了」的同一组参数）；
    //     #1009 的 bump/0.15 不再使用。★保留：#1006 碗形、#1007/#1008 面纱 α —— 均未受影响。
    //   ★教训：**"位移剖面会折叠"的判据必须带方向**（s'=1−bend'，不是 |bend'|>1）；探针出现"额外结构"先问
    //     "它是不是本来就该被采进来"（条外内容/倒影），再判 bug。
    let prof = pow(1.0 - e, 3.0);   // ★#1010：恢复 #998/#928 —— 边缘侧采样延伸至条外 = 倒影/吸入
    let EDGE_REFRACT = 1.20;        // ★#1010：0.15→1.20（恢复 #1006 验收口径）
    let strength = clamp(u.refract_depth / max(band, 1.0), 0.2, 1.1);
    var bend = prof * band * EDGE_REFRACT * strength;
    // ★★★决策 #905：**触控形变流动**——触点周围局部凸起（Gaussian 钟），按压力把背后内容沿"离触点方向"推开；
    //   `press==0` ⇒ 该项为 0（退化到既有折射，像素等价）。
    let tR = max(hsmin * 0.9, 8.0);
    let td = local - u.touch;
    // ★★★决策 #965：触点钟形**只给选中项（overlay）**——此前给命中玻璃（条）⇒ 按下处局部透出背景 ⇒
    //   用户「按下条也跟着变通透」（按哪哪透，看着像 morph 其实不是）。
    let tg = exp(-(dot(td, td)) / (2.0 * tR * tR)) * u.press * clamp(u.overlay, 0.0, 1.0);   // 0..1 触点钟形（仅亮环用）
    // ★★★决策 #968：**不再做触控内容位移（push=0）**——用户实测「iOS 按下**下面的内容不动**，
    //   只有玻璃**轮廓边**被充气」。此前 `push` 沿"离触点方向"推挤背后内容 ⇒ 读作"内容被挤压"（明确偏离 iOS）。
    //   现在按下只改**剪影**（宿主外凸路径 + 沿充气轮廓的亮环）与**内部光学**（边缘折射与静态同）⇒ 内容零位移。
    // ★★★决策 #998（用户「#997 中腹对了，但边缘还是不像 iOS 的**玻璃反射**」）：**边缘镜像反射**。
    //   向外推 `sp = local + n·bend` 只是**平移**；真"反射" = 采样点出界后**沿法线镜像折回**
    //   （玻璃边缘像内凹镜面 ⇒ 把**外侧**内容**翻转**折进来）。⇒ 出界量 `sd_sp` 沿法线折回 2×。
    let sp = local - n * bend;   // ★#998：**向内采样**（#918 原式）——边缘内容被"拉向边缘"=拉伸 + (1−e)³ 折叠=倒影

    // ★★★决策 #976：**按下透镜「内部放大」（凸模式放大镜）**——用户「iOS 本身按下就会放大、松开回弹」
    //   + workbuddy ②「透镜内部零折射 ⇒ 读作和条同一块面」。此前位移集中在极边缘 `(1-e)³` ⇒ **内部零位移**。
    //   iOS 透镜内部是**凸模式放大折射**：内容整体被放大（放大镜感）⇒ 这才让"胶囊 ≠ 条面"（区域级差异）。
    //   实现：采样点向**盒中心**收缩 `zoom` 倍 ⇒ 放大（zoom>1）。门控 `pr_ov`（仅按下×选中胶囊）——
    //   **条（overlay=0）与静止态 ⇒ zoom=1 ⇒ 逐像素等价**（parity 不受影响）。
    //   ★守住 #968：这里只放大**胶囊内部**（透镜里的内容/图标），**不改条下面的内容**（两者不同层、不冲突）。
    let ctr = hs;                                    // 盒中心（local 空间）
    let zoom = 1.0 + pr_ov * 0.08;                   // ★#981：轻放大（保留透镜感；0.16→0.08 以免把条推走）
    let spL = ctr + (sp - ctr) / zoom;               // spL = 放大后的采样点
    let sp_uv = spL / u.size_px;

    // ③ 模糊按 e 键控（边缘锐、中心糊）；核最大半径 = blur*e*0.55
    // ★决策 #906：**零采样**——不做任何模糊（对齐用户对 iOS 的理解：内容不糊，只磨砂叠加）。
    // ★★★决策 #978：**按下透镜「自低通」（凸透镜的柔）**——workbuddy B：iOS 透镜内部比条**柔**
    //   （std 0.43× / 梯度 0.70 vs 条 2.79），我们更锐（1.95×）⇒ 面纱一关就成"挖洞"（原始高频直透）。
    //   iOS 通透 = 内容被**放大 + 轻模糊 + 位移**（凸透镜），不是"洞"。⇒ 内部加 5-tap 十字轻低通。
    //   ★#1003：该 5-tap 由下方「大半径模糊」取代（同口径已覆盖按下态）——旧 br2 删除。
    // ★★★决策 #1003（承 #1002 定稿「11 项机制」的 P0）：**大半径模糊 = 内容透射的核心分量**——
    //   #1002 逐帧实证：跨条边界同一内容边缘锐度 **207→8（~25×）**、细字对比抹到 ≤8%（鬼影）、
    //   块状保留 ~1/3 ⇒ **"白底不像玻璃"的头号缺失**。本实现 = **9-tap 二项式**
    //   （[1,2,1]/4 ⊗ [1,2,1]/4，等效 σ = 格距 d）。采样点 = 位移/放大之后的 spL（同口径作用于全玻璃）。
    //   ★σ 标定（物理px，本会话两条独立线）：① 真机 f0060 同字跨条缘——细笔画条内残差 Δ5-8 / 条外 Δ175-190，
    //     剥掉面纱（浅端 t≈15%）反解模糊保留率 ≈0.23-0.3 ⇒ **σ ≈ 5-7px**；② 本机 oracle 标定——
    //     b=3.12px（σ_eff=2.2px）下 12px 条纹保留 ~100% ⇒ 太弱（真机网格边界仅 0.8→2-4px 过渡）。
    //     取 `d = clamp(u.blur·0.16, 0, 8)`（glass-nav blur=39 ⇒ b=6.24px，**σ_eff = b/√2 ≈ 4.4px**，
    //     居 5-7 下沿偏保守；先落此档真机目视，不足再加档）。
    //   ★与 #986 的边界（用户当年否过"全局 3×3 盒式"并撤回）：那次格距 = `u.blur·0.30`（39 → 11.7px，
    //     σ_eff≈9.5px）⇒ 过度模糊把字形糊没；本项 σ ≈ 其 0.46（**削锐度、保字形**）——只改"清晰度"，
    //     不改色相（saturation/去饱和链路不动）、不改结构。
    //   ★★★决策 #1003 订正（本机 oracle 实证的 R 通道反例）：**色散采样必须同样过模糊核**——
    //     #999 的 `acc = vec4(aR.r, acc.g, aB.b)` 用**单点** aR/aB 整替换 R/B 通道 ⇒ **模糊只在 G 通道存活**
    //     （实测：4px 亮线在 blur=39 下 R 通道纹丝不动 65→65、编码无变化）⇒ 去饱和后灰度内容几乎无模糊。
    //     ⇒ 三个累加器各跑**同一 9-tap 核**（基色 · R 在 +n·disp · B 在 −n·disp）⇒ 色散 = "错位的模糊图"（真色差语义）。
    //   ★`u.blur=0` ⇒ 9 tap 同为一点、权重和 = 1 ⇒ 逐像素等价（零回归）；erf 口径下 σ_eff=4.4px 对 4px 笔画
    //     对比保留 ~30%，叠加面纱后 ≈ iOS 实测残差（≤8% 量级）。
    //   ★成本诚实：27 次 textureSample（3×9）——玻璃节点像素量小（条 ~190k px），本机 GPU 余量足够；
    //     若未来要省，可改 `textureSampleLevel` + disp 分支（非一致控制流），当前先保正确性。
    //   ★★★决策 #1004：**tap 间距分档**（消「重影」）——见 struct `nest` 注释：锐背板模式保持 #1003 口径；
    //     宿主深链预模糊后本核退为**小残差**（d < 笔画宽 ⇒ 无副本分离）。
    //   ★★★决策 #1005：**可读性修正**——深链（/2→/4→/8→/4→/2）的末级 16px bilinear 核**在 16px 尺度过零**
    //     （文字笔画/字间隙恰为 8–16px ⇒ 字形结构被精确杀灭，用户「文字都看快不见了」，真机实证：
    //     同 σ 下稀疏核字形可辨 / 深链只剩白雾）。⇒ 宿主回退「单次 /2 轻降采样」（σ≈0.5px，仅抗锯齿），
    //     主模糊由本核承担：d = blur·0.08（39 ⇒ **3.12px**，σ_t≈2.2px）——d < 笔画宽（6–8px）⇒ 无副本分离；
    //     总 MTF(16px 结构) ≈ 0.53，对齐 iOS 实测（≈0.5，字形可辨）。
    //   ★d=3.12px < 笔画宽 ⇒ 副本重叠、无"重影"（#1004 的仿真结论继续成立）；间距比 #1003 的 6.24px 小一半。
    var bsig = clamp(u.blur * 0.16, 0.0, 8.0);        // 模式 0/1：锐背板（= #1003 口径，逐像素不变）
    if (u.nest > 1.5) { bsig = clamp(u.blur * 0.07, 0.0, 8.0); }    // 模式 2：轻链背板 ⇒ 主模糊（#1007：0.08→0.07——细笔画更成形）
    if (u.nest > 2.5) { bsig = clamp(u.blur * 0.04, 0.0, 8.0); }    // 模式 3：内层·复合帧（已被外层糊过）
    // ★★★决策 #1012（用户「iOS 非常**干净利落**的文字吸进去…我们的文字映射始终和 iOS 有差异」）：
    //   **模糊按 e 键控**——iOS 实证（workbuddy v2/video 逐帧）：**贴边折射带细节保留 85–93%**
    //   （压缩但成形）、**只有中腹重糊**（对比残留 12–18%）。我们此前模糊**全局**（9-tap 不分位置）⇒
    //   贴边带的折叠副本（= 用户看到的"文字分身"）也被糊掉 ⇒ 读不出来（"差异"的机制本体）。
    //   ⇒ 模糊强度乘 e-键控：贴边不糊 / 中腹全糊（平滑过渡）。
