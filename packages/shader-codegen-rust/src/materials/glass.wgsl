// packages/shader-codegen-rust/src/materials/glass.wgsl
// ★★★液态玻璃材质 —— **框架唯一的算法真源**（决策 #834）。
//
// 【这份 WGSL 是什么】它是「液态玻璃」算法**唯一的一份实现**。各端不再各写一份着色器：
//   由 Rust（naga）把本文件落成 iOS Metal(MSL) 与 Android AGSL（GLSL-ES-3.10 方言）；鸿蒙同源落地。
//   观感 = 依 `GlassSpec`（blur/tint/radius/saturation）+ 本算法。参数由内核 `LStyle.glass` 透传。
//
// 【算法模型（= 决策 #825/#827 的"边缘倒角厚板"）】中心平坦（不折射）、仅最外倒角带折射
//   （沿外法线把边界外内容卷进来）、模糊按离边距离键控（边缘锐/中心糊）、去饱和+磨砂白、Fresnel 高光。
//
// 【接口契约（宿主必须满足）】
//   · **渲染目标 = 节点盒**；片元用 `@builtin(position)` 拿**渲染目标像素坐标** frag.xy，
//     减去 `origin`（节点盒在渲染目标内的左上角）⇒ 盒内像素坐标 local = frag.xy - origin，
//     uv = local / size_px。★这样两端统一：Metal 离屏渲染节点盒（origin=0,0）；AGSL 直接画进主画布
//     （origin=节点在画布中的左上角）——同一份算法、只在 uniform 里换 origin。
//   · 纹理 `backdrop`：节点盒**外扩 padding** 后的背景（供边缘折射采到盒外内容）；
//     `tex_scale`/`tex_bias` 把节点 uv 映射到该纹理 uv：sample_uv = uv * tex_scale + tex_bias。
//   · `size_px`：节点盒在**设备像素**下的尺寸（用于 SDF/模糊的 px 量纲）。
//   · uniform 布局见 src/materials/mod.rs 的 `GlassUniforms`（#[repr(C)]，字节偏移已钉）。
//
// 【★改这里 = 改全端】禁止在任何宿主再手写玻璃着色器（门禁 check:shader-capability 会咬）。

@group(0) @binding(0) var backdrop_tex: texture_2d<f32>;
@group(0) @binding(1) var backdrop_smp: sampler;

struct GlassUniforms {
    tint: vec4<f32>,          // 0  着色 RGBA（内核算好的 #RRGGBBAA 归一）
    size_px: vec2<f32>,       // 16 节点盒尺寸（设备像素）
    origin: vec2<f32>,        // 24 节点盒在渲染目标内的左上角（设备像素；Metal=0，AGSL=c.x/c.y）
    tex_bias: vec2<f32>,      // 32 节点uv→纹理uv 的偏置
    tex_scale: vec2<f32>,     // 40 节点uv→纹理uv 的缩放
    light_dir: vec2<f32>,     // 48 光照方向（归一）
    radius: f32,              // 56 圆角（设备像素）
    blur: f32,                // 60 模糊半径（设备像素）
    refract_depth: f32,       // 64 边缘峰值位移（设备像素）
    specular: f32,            // 68 镜面高光强度
    saturation: f32,          // 72 饱和（1=中性）
    // ★★★决策 #911：**区域背景亮度**（0..1）——宿主统计玻璃盒（含 pad）区域的**平均亮度**。
    //   【为什么需要（对齐 iOS `.regular`）】iOS「each layer continuously adapts based on what's behind it」/
    //   「flip from light to dark based on the background」⇒ 玻璃的**明暗基调随整块背景切换**（浅霜/深霜），
    //   而非只与"该像素正后方"有关（那是 #908/#910 的逐像素形态，缺"区域"这一级）。
    //   ★**零布局变更**：本槽原为 `_pad`（闲置对齐填充，三端都设 0）⇒ 直接语义化复用，结构仍 96B。
    bg_lum: f32,              // 76 区域背景亮度（0..1；宿主统计；缺省 0 = 视作深底）
    // ★★★决策 #905：**触控形变**（对齐 Apple `UIGlassEffect.isInteractive`）——点按/拖动时
    //   玻璃在触点处产生液态流动（局部凸起 + 折射被"推"开 + 触点高光增强），松手回弹。
    touch: vec2<f32>,         // 80 触点在**玻璃盒局部设备像素**（未激活 = (-1e6,-1e6)）
    press: f32,               // 88 按压强度 0..1（host 逐帧 lerp 动画）
    overlay: f32,             // 92 ★#952：选中胶囊**叠加层**强度（0=无 / 1=叠半透明中性色：light→灰 · dark→亮；**不动面纱 α**）
};
@group(0) @binding(2) var<uniform> u: GlassUniforms;

// 圆角矩形 SDF（真欧氏距离；内部为负）
fn sd_round_rect(p: vec2<f32>, hs: vec2<f32>, r: f32) -> f32 {
    let q = abs(p) - hs + vec2<f32>(r, r);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2<f32>(0.0, 0.0))) - r;
}

// 圆弧倒角映射（Kyant）：x=0 外缘 → 0，x=1 内侧 → 1
fn circle_map(x: f32) -> f32 {
    return 1.0 - sqrt(max(1.0 - x * x, 0.0));
}

// 按节点uv 采样背景（经 tex_scale/tex_bias 映射到纹理uv）
fn sample_backdrop(uv: vec2<f32>) -> vec4<f32> {
    return textureSample(backdrop_tex, backdrop_smp, uv * u.tex_scale + u.tex_bias);
}

// ★★★决策 #966/#969：**按下 SDF 形变（形状域）**——触点附近轮廓**内陷（凹）**（增大 SDF = 外形收缩）。
//   ★#969 修正方向（用户「玻璃条本身的边不是鼓，是内陷了」+ iOS 18:53 暗底实拍）：iOS 按下 = 玻璃表面在
//     触点处**凹进去**（露透镜状背景 + 彩虹色散边），**不是**凸出 ⇒ 以前做成外凸是**反向**。
//   ★★本函数只定**剪影/亮环**；**法线/位移仍取原轮廓**（见 fs_glass）——否则内容被挤（#968/#969 实证）。
//   ★纯 `press × overlay` 门控（未按 ⇒ 逐像素等价 sd_round_rect，parity 不变）。
fn sd_glass(p: vec2<f32>, hs: vec2<f32>, r: f32, tp: vec2<f32>, press: f32, hsm: f32) -> f32 {
    var v = sd_round_rect(p, hs, r);
    let pr = clamp(press, 0.0, 1.0);
    if (pr > 0.001) {
        let td = p - tp;
        let br = hsm * 1.25;                       // 形变横向展布
        let bulge = exp(-dot(td, td) / (2.0 * br * br));
        v = v + bulge * (hsm * 0.42) * pr;         // ★#969：增大 SDF ⇒ 轮廓**内陷**（凹，对齐 iOS）
    }
    return v;
}

@fragment
fn fs_glass(@builtin(position) frag: vec4<f32>) -> @location(0) vec4<f32> {
    let local = frag.xy - u.origin;      // 盒内像素坐标（origin = 节点盒左上角）
    let hs = u.size_px * 0.5;
    let p = local - hs;
    let r = min(u.radius, min(hs.x, hs.y));
    let hsmin = min(hs.x, hs.y);
    // ★#966：按下 SDF 充气（形状域）由模块级 `sd_glass()` 完成（WGSL 不允许函数嵌套）。
    //   ★门控 = `press × overlay`：**只让选中胶囊（overlay）变形**，条（overlay=0）保持静止——
    //     与 #965 同口径（用户「按下条也跟着变」是明确的回归）。
    let pr_eff = clamp(u.press, 0.0, 1.0) * clamp(u.overlay, 0.0, 1.0);
    let tpp = u.touch - hs;                          // 触点在 p 空间
    // ★#968：**轮廓（几何）**用充气后的 SDF——只喂**亮环**（见 ⑥）；
    //   而 `d`/`e`/**法线**/位移一律用**原轮廓** —— 用户实测「iOS 下面的内容不挤压，只有玻璃边被充气」。
    //   ★教训：充气改法线 ⇒ 折射把**玻璃下面的内容**也带弯 = 挤内容（非 iOS）。形状域变形只应改剪影。
    let sd_run = sd_glass(p, hs, r, tpp, pr_eff, hsmin);   // 充气轮廓（仅亮环用）
    let sd = sd_round_rect(p, hs, r);                     // 原轮廓（d/e/法线/位移用）
    let d = max(-sd, 0.0);               // 离边深度（内部为正）
    let smin = min(u.size_px.x, u.size_px.y);   // 最短**边**（= 2×hsmin）
    // ★★★决策 #907/#910：折射带 ≈ **最短边 1/3**（= 条高 1/3）。
    //   ★#910 修正口径（报告 G3）：原 `hsmin*0.33 = 0.165·min` 实为**最短边的 1/6**（注释称"1/3"、
    //   代码只有一半 ⇒ 带宽被砍半 ⇒ 真机"折射区比 iOS 少很多"）。改 `0.33·min` ⇒ 带宽 **×2**，与注释/iOS 实测一致。
    let band = max(smin * 0.30, 6.0);
    let e = clamp(d / band, 0.0, 1.0);   // 0=最外缘, 1=内侧（带内）

    // ① 外法线（SDF 梯度；宽 eps 防药丸中轴裂缝）
    let eps = clamp(band * 0.3, 1.0, 16.0);
    // ★#968：法线取**原轮廓**的梯度（内容不动——充气不改法线，否则折射把下面内容挤弯）。
    let g = vec2<f32>(
        sd_round_rect(p + vec2<f32>(eps, 0.0), hs, r) - sd_round_rect(p - vec2<f32>(eps, 0.0), hs, r),
        sd_round_rect(p + vec2<f32>(0.0, eps), hs, r) - sd_round_rect(p - vec2<f32>(0.0, eps), hs, r));
    let n = g / max(length(g), 1e-5);

    // ② 位移场（透镜弯曲）：**位移横贯整个边缘带**（峰值在外缘、向中心平滑归零，中心平坦）。
    //   ★#907 关键修正：旧式 `bend *= smoothstep(1.0, 0.75, e)`（内缘淡出）把位移**只留在带的外侧一小段**
    //     ⇒ 可见位移仅 ~4px（"液态感消失"的真凶）。Apple 的位移横贯整带（带内到处可见压缩漩涡）。
    //   ⇒ 改用 `prof = 1 - smoothstep(0,1,e)`（带外缘 1 → 带内缘 0，S 形平滑覆盖**整带**，两端 C1）。
    //     位移峰值 = 带宽 × 0.45（与带同尺度 ⇒ 自洽，不再依赖宿主传入的 refract_depth 数值）。
    let ec = clamp(e, 0.004, 0.996);
    let u1 = 1.0 - ec;
    let slope = u1 / sqrt(max(1.0 - u1 * u1, 1e-4));
    // ★★★决策 #924（依据 iOS 逆向调研 .workbuddy/memory/2026-10-14.md §逆向结论）：
    //   iOS 核心 shader **仅 4 入参**（backdrop / sdf / ref_height 带高 / ref_length 位移），位移 = 沿边缘法线的
    //   **线性映射**；三种模式由 **ref_length/ref_height 比值**决定 —— <1 凹(缩小) / >1 凸(放大) / ≈1+ **边缘反射(镜像)**
    //   （文章注明：**苹果 GUI 最常用 = 边缘反射**）。⇒ 剖面改**线性**（不再是 (1-e)^3 的自造曲线）。
    let prof = pow(1.0 - e, 3.0);   // ★#928 回退#924：位移**集中在极边缘**（#918 用户认可版；(1-e) 线性铺满整带 ⇒ 内容糊烂）
    // ★★★决策 #910/#912/#914 · 位移峰值系数 `EDGE_REFRACT`（**方向已冻结，只调幅度**）
    //   【#914 用户真机】「iOS 的折射只有**平面变化**，我们的明显**文字有 y 轴拉伸**」——取证（oracle 细线探针）：
    //     位移机制（沿外法线向外采样 ⇒ 边缘带内容被压缩/弯折）**方向正确**；问题是**幅度**：`0.55·band`
    //     = 0.55×67 物理px ≈ **37px ≈ 半个字高** ⇒ 整带沿法线大幅平移 ⇒ 读作"竖向拉伸"（内容被非均匀挤压）。
    //   ⇒ 幅度降到 **0.15·band**（≈10 物理px ≈ 3 逻辑px）：线间距接近均匀（仅边缘轻微弯折，对齐 iOS"平面变化"）。
    //   ★这是**定稿方向**（不再漂移）：机制=法线方向向外采样（单调、不折叠）+ 小幅度（平面式轻弯折）。
    //   A 分解：`EDGE_REFRACT`（幅度）· `strength`（宿主 refract_depth 旋钮，1.0 中性）。
    let EDGE_REFRACT = 0.70;   // ★#928：1.10→0.70（#918 用户认可版；1.10 幅度过大 ⇒ 内容被拉烂）
    let strength = clamp(u.refract_depth / max(band, 1.0), 0.2, 1.1);
    var bend = prof * band * EDGE_REFRACT * strength;
    // ★★★决策 #905：**触控形变流动**——触点周围局部凸起（Gaussian 钟），按压力把背后内容沿"离触点方向"推开；
    //   `press==0` ⇒ 该项为 0（退化到既有折射，像素等价）。
    let tR = max(hsmin * 0.9, 8.0);
    let td = local - u.touch;
    // ★★★决策 #965：触点钟形**只给选中项（overlay）**——此前给命中玻璃（条）⇒ 按下处局部透出背景 ⇒
    //   用户「按下条也跟着变通透」（按哪哪透，看着像 morph 其实不是）。
    let tg = exp(-(dot(td, td)) / (2.0 * tR * tR)) * u.press * clamp(u.overlay, 0.0, 1.0);   // 0..1 触点钟形（仅亮环用）
    // ★★★决策 #968：**不再做触控内容位移（push=0）**——用户实测「iOS 按下**下面的内容不动**，
    //   只有玻璃**轮廓边**被充气」。此前 `push` 沿"离触点方向"推挤背后内容 ⇒ 读作"内容被挤压"（明确偏离 iOS）。
    //   现在按下只改**剪影**（宿主外凸路径 + 沿充气轮廓的亮环）与**内部光学**（边缘折射与静态同）⇒ 内容零位移。
    let sp = local - n * bend;   // ★#918：仅保留边缘折射（与静态同口径），无触控内容位移
    let sp_uv = sp / u.size_px;

    // ③ 模糊按 e 键控（边缘锐、中心糊）；核最大半径 = blur*e*0.55
    // ★决策 #906：**零采样**——不做任何模糊（对齐用户对 iOS 的理解：内容不糊，只磨砂叠加）。
    var acc = sample_backdrop(sp_uv);
    var col = acc;

    // ④ 去饱和（**轻微**：保留背后颜色——对齐 Apple「玻璃取其正后方之色」）+ 饱和旋钮
    //   ★决策 #875：0.30 → 0.12。此前固定 30% 去饱和把背后颜色冲淡成"灰玻璃"，与 Apple 语义相悖。
    let lum = dot(col.rgb, vec3<f32>(0.299, 0.587, 0.114));
    col = vec4<f32>(mix(col.rgb, vec3<f32>(lum), 0.12), col.a);
    col = vec4<f32>(mix(vec3<f32>(lum), col.rgb, u.saturation), col.a);

    // ⑤ ★★★决策 #926（★本段历经 #908→#913→#920→#911→#923 五轮迭代，最终由 iOS 逆向调研的**4 图定量**定案）：
    //   历史坑（对照保留，防回退）：① #908 二极开关/仿射方向错（深底被压暗）；② #910 逐像素亮度平移 ⇒ 洗白内容；
    //     ③ #913/#920 混向平底白 ⇒ **糊平内容** ⇒ 折射/倒影不可见（#923 回退）。三者共性 = **改的是"内容"**。
    //   【正解（iOS 4 图定量拟合）】iOS 玻璃亮度是**区域背景亮度的线性函数**：
    //   `glass_L = 0.777·bg_L + 0.195`（4 点拟合：46→90 / 53→92 / 91→114 / 240→238，误差 ≤5）。
    //   ⇒ 斜率 <1 = **对比度压缩（向中调靠拢）**——这就是 HIG「flip from light to dark」的本质：
    //     **深底大幅提亮、亮底近中性微压**（不是"朝固定白霜锚点"）。
    //   ★实现为**均匀亮度位移**（对各通道加同一 delta，**不依赖逐像素 lum** ⇒ 保住内容对比 ⇒ 折射/倒影可见，
    //     避开 #910 逐像素平移"洗白内容"与 #920 混白"糊平内容"两个坑）。
    // ★★★决策 #931（**修正 #926 的机制错误**）：用户「iOS 有明显磨砂感，我们的直接透明」。
    //   【#926 错在哪】它拟合的是 iOS 玻璃的**均值**（4 点），落地成**加法亮度位移** ⇒ **对比度 1.0× 保留**
    //     ⇒ 内容清晰透出 = **"透明"**。而用**两张不同背景的截图联立**（深底 L79→玻璃 215 · 浅底 L252→玻璃 237）
    //     解出真实模型是 **glass = mix(bg, L≈203, α≈0.28)** ⇒ **对比度压到 0.72×** ⇒ 才有"磨砂"。
    //     ★教训：**拟合"均值"会漏掉"斜率"**——亮度对了、对比度错了，观感天差地别。
    //   ⇒ 改为**面纱（veil）**：混向一个浅底（0.80）28%（既压对比=磨砂，又提亮=对齐 iOS 明暗）。
    // ★★★决策 #943（**修正 #942 的方向 + 定标**）：**`bg_lum` 驱动面纱 α（自动透明度）**。
    //   【为什么再修（用户真机对照图）】#942 把方向**做反了**——它让"深底 α 大 / 浅底 α 小"，结果**浅底内容清晰可见**
    //     （用户：「iOS 浅底内容几乎不可见，我们清晰得很」）。重新按 4 图**逐点反解** α（`glass=(1-α)·bg+α·V`，V≈255 近白锚）：
    //     bg50→182 **α=0.64** · bg40→183 **α=0.67** · bg90→185 **α=0.58** · bg237→253 **α=0.89** ⇒ **浅底 α 反而更高**（≈0.9，近乎不透明白霜）。
    //     ⇒ 方向纠正为 **α 随 bg_lum 递增**：浅底 → 强白霜（内容糊没，对齐 iOS）；深底 → 较弱（暗底仍透出内容）。
    //   ★这是"自动调整透明度"的落点：宿主已逐帧统计 `bg_lum`（Android `regionLum` / iOS `regionL`）。
    //   ★诚实边界：α 由 4 图反推（V 取近白），真机目视再定微调；iOS/鸿蒙同步（同源真源，仅 Android 真机验证）。
    let VEIL_V = 1.0;                                                  // 面纱基色（**纯白**——浅底 alpha 0.9 时才能够到 iOS L253）
    // ★★★决策 #949：**α 随背景明暗"翻转"（重映射，非线性）**——用户「iOS 深底白霜非常浅 / 我们黑底还发白」。
    //   【真值】iOS 深底（页暗）：玻璃 ≈ **深色半透明**（L80 / 背景 56 ⇒ 白霜极浅、几乎透出暗背景、文字转白）；
    //     iOS 浅底（页亮，如 App Store 白页）：玻璃 ≈ **白霜**（L182）。⇒ 深底 α 须**极低**（≈0.15）、浅底高（≈0.9）。
    //   【为何重映射】线性 mix(0.15,0.9, bg_lum) 在 bg_lum≈0.2（暗内容）仍给 α≈0.30 ⇒ 还是发白。
    //     改用**阈值重映射**把"低 α"铺满整个暗区（bg_lum<0.25 恒 0.15），仅亮区快速升到白霜。
    let veil_t = clamp((u.bg_lum - 0.25) / 0.60, 0.0, 1.0);           // 暗区(bg_lum≤0.25)恒 0；亮区(≥0.85)恒 1
    // ★★★决策 #952：面纱 α 对**条与胶囊同口径**（内容可见度一致——#951 的"反相 α"会改内容可读性，已废弃）。
    // ★★★决策 #966（**订正 #965**）：**面纱 α 不因按下而变**——用户「两块玻璃叠加互不影响，按下胶囊不该让内容透出来」。
    //   #965 把按下时面纱砍到 14% ⇒ 胶囊直接透出**原始内容**（比条更清晰）——错。正解：面纱与条**同口径**，
    //   按下的形态变化只由「灰叠加退场」（见下 overlay 段）表达 ⇒ 胶囊 = 同条材质的玻璃、内容清晰度 = 条。
    let VEIL_A = mix(0.09, 0.90, veil_t);   // 深底 0.09 → 浅底 0.90（与条同口径，不随 press 变）
    // ★★★决策 #925：**12% 背景色温**（iOS 实证：蓝底玻璃 B−R=+9.0 vs 背景 +75.6）——只取背景的
    //   **色度偏移**（色 − 其灰度）× 12%（色相，不动明度）。
    let acc_chroma = acc.rgb - vec3<f32>(dot(acc.rgb, vec3<f32>(0.299, 0.587, 0.114)));
    let veil_col = clamp(vec3<f32>(VEIL_V) + acc_chroma * 0.12, vec3<f32>(0.0), vec3<f32>(1.0));
    col = vec4<f32>(mix(col.rgb, veil_col, VEIL_A), col.a);
    // ★★★决策 #952：**选中胶囊叠加层（overlay）**——对齐 iOS「按下态」：light→灰 / dark→亮。
    //   ★与 #951 的关键区别：**不动面纱 α**（内容可见度 = 与条相同），只在其上**叠一层半透明中性色**。
    //   ⇒ 观感"灰蒙蒙"（浅底）/ "亮蒙蒙"（深底），与条恒有差异，且**不改变透过内容的不透明度**。
    if (u.overlay > 0.001) {
        // ★#958：两端收拢（用户「白底胶囊太暗 Δ−46 / 黑底太亮 Δ+56」）——收到 ±~29：
        //   白底 bar≈254 ⇒ 胶囊 225（浅灰压暗）；黑底 bar≈35 ⇒ 胶囊 64（略提亮）。仍随 `veil_t`（=采样 bg_lum）自适应。
        let ov_l = mix(0.52, 0.62, veil_t);                           // 深底→0.52 / 浅底→0.62
        // ★★★决策 #964：**按下 ⇒ 淡出灰叠加（morph 成通透玻璃透镜）**——用户「按下还是灰的、iOS 完全通透」。
        //   iOS 选中项静止=灰药丸（dimming），按下=**完整液态玻璃**（灰 dimming 退场、露出折射/通透）。
        //   ⇒ overlay 权重乘 `(1 − press)`：静止=灰药丸，按下=纯玻璃。
        let ov_a = clamp(u.overlay, 0.0, 1.0) * 0.30 * (1.0 - clamp(u.press, 0.0, 1.0));
        col = vec4<f32>(mix(col.rgb, vec3<f32>(ov_l), ov_a), col.a);   // ★#952/#964
    }
    // ★★★决策 #944：**tint 移到面纱之后**——作者 tint 应作用于**最终玻璃面**，而非"内容色"。
    //   此前 tint 在面纱（#943 α 0.94 近白）**之前** ⇒ 暗 tint（选中胶囊 rgba(115,115,115,…)）被面纱**整片洗白**
    //   ⇒ 胶囊与条同色 ⇒ 「几乎看不到选中胶囊」（用户实测）。移到之后：白 tint（各 preset）不受影响，
    //   灰 tint（胶囊）= 白玻璃面**压暗** ⇒ 重新可见（对齐 iOS 选中胶囊「比主体暗 13~35」）。
    col = vec4<f32>(mix(col.rgb, col.rgb * u.tint.rgb * 2.0, u.tint.a), col.a);

    // ⑥ 光照：Fresnel + 法线·光源（双瓣）＋ ★★★决策 #906 **兜底可见性**（对齐 iOS：**纯色/空白背景上玻璃仍可见**）
    //   【缺口】此前玻璃完全依赖"背景内容的折射"⇒ 背景是纯色/空白灰时**玻璃几乎消失**（真机实测，用户点名）。
    //   iOS 兜底 = ① **恒定发丝高光边**（不依赖背景，勾勒轮廓）② 顶边更亮（顶光）③ 整体略亮于背景。
    let cos_i = inverseSqrt(1.0 + slope * slope);
    let f0 = 0.04;
    let fres = f0 + (1.0 - f0) * pow(max(1.0 - cos_i, 0.0), 5.0);
    let facing = max(dot(n, normalize(u.light_dir)), 0.0);
    let bevel_mask = 1.0 - smoothstep(0.0, 0.10, e);   // ★#915：细亮线（~2px）
    // ★★★决策 #954：**边缘高光整体减半**（用户「顶部高光很明显、iOS 是微微一层基本看不出」）——
    //   ★真机实测：我们顶缘 **+79/255 且顶到 255（饱和）**；iOS 同口径 **+38/255**（不饱和）。
    //   各系数约减半（顶缘加成 0.26→0.05 为大头）；specular 项另乘 0.22（`pow(facing,6)` 在顶缘≈0.69 ⇒ 原贡献 ~0.24）。
    let top_hi = max(-n.y, 0.0);                        // 上缘（n.y≈-1）
    let edge_hi = bevel_mask * (0.025 + 0.05 * top_hi + 0.03 * facing);
    // ★★★决策 #915 · **删除 `edge_pol`（"自适应描边极性"）**——用户实测「边缘随背景发亮发暗，不对」。
    //   取证：iOS 边缘是 **specular 高光（恒亮）**，**不随背景翻转**。旧 `edge_pol`（#910 引入）让亮底边缘**减暗**
    //   ⇒ 既非 iOS，又让"文字经过边缘变亮"（宽带时更糟）。⇒ 缘带收窄到 0.10 后**恒定加亮**（恢复 iOS 语义）。
    // ★★★决策 #947：触点高光 `tg*0.30` → **`tg*0.07`**（用户「有一个光斑跟随手指」）——
    //   `0.30×tg` 最大 +76/255 的**亮斑**（真机实测光斑比条亮 +60~70），iOS 的交互玻璃是**折射扰动**（不是亮斑）。
    //   ⇒ 压到 0.07（几乎不可见，保留一丝反馈）。★#968：触控**内容位移 `push` 已移除**（按下不改内容）。
    // ★★★决策 #953：**边缘高光按 overlay 门控**——`overlay=1`（选中胶囊）⇒ 无边缘高光（用户「选中胶囊四周有高亮的边，不需要，
    //   干净卡片贴上去即可」）。其余玻璃（overlay=0）边缘高光不变。
    // ★★★决策 #956 撤回：**iOS 选中胶囊实测无高亮边**（顶边 78→109 / 右边界 120→89，皆为**干净色阶、无过亮尖峰**；
    //   此前误把"条自身顶缘高光"(y2285 L142，恰在胶囊上方) 当成胶囊的边）。⇒ 选中等 overlay 玻璃**无边缘高光**（#953 原判正确）。
    let edge_amp = 1.0 - clamp(u.overlay, 0.0, 1.0);
    // ★★★决策 #963：**按下「点亮透镜」**——press>0 的玻璃（按下组：条 + 选中胶囊）加一道**镜面亮边**
    //   （对齐 iOS 按下：边缘镜面亮脊 +67L，子代理实测；我们此前按下=edge_amp 把亮边全关了 ⇒ 死平）。
    // ★#965：亮边只给**选中项（overlay 玻璃=胶囊）**——否则条（overlay=0）也被点亮 ⇒ 用户「条也跟着变通透」。
    // ★★★决策 #967：**按下亮环**——沿**充气轮廓**的亮边（iOS 按下透镜的亮边），压在暗底也读得出。
    //   ★为什么必须加强（真机取证）：按下后胶囊填充变**透明**（#964）⇒ 在暗底上填充与玻璃条同亮度（实测
    //     胶囊中心列 lum≈46 = 条，**轮廓完全看不见**），只有底部凸出到白色内容处才显形。用户「只有下边被挤压、
    //     上边完全看不到」的真因 = **缺亮边**（iOS 的按下透镜 = 透明填充 + 一圈亮边 ⇒ 上下轮廓都读得出）。
    //   ★带略宽于常态 bevel（0.10→0.16）以在真机分辨率下可见；系数 0.32→0.55。
    //   ★按 **sd**（充气后轮廓）取环，而非 `e`——充气把 SDF 收缩后，真边缘处的 `e` 被推到 >0.16 ⇒ 用 `e` 会把环整段杀掉（实测）。
    let pv_rim = clamp(u.press, 0.0, 1.0) * clamp(u.overlay, 0.0, 1.0);
    let rim_w = max(min(u.size_px.x, u.size_px.y) * 0.06, 2.0);   // 环宽（px）
    let press_rim = (1.0 - smoothstep(0.0, rim_w, abs(sd_run))) * pv_rim * 0.55;   // ★#968：取**充气轮廓**
    let rim = ((pow(facing, 6.0) * u.specular * 0.22 + fres * 0.06) * bevel_mask + edge_hi) * edge_amp + press_rim + tg * 0.07;   // ★#954/#956/#963
    // ★★★决策 #966：**按下 SDF 充气**（形状域）只改**内部光学**（法线/折射/高光跟随充气轮廓）。
    //   ★剪影由**宿主几何**（`GlassMaterial.inflatedPillPath` 外凸路径裁剪）给出——实测本设备
    //     忽略 `RuntimeShader` 返回的 alpha（返回 0 / 圆覆盖率都仍画成不透明矩形）⇒ 覆盖率不可用。
    col = vec4<f32>(clamp(col.rgb + vec3<f32>(rim), vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
    return col;
}
