{
  "name": "@proteus-vue/contracts",
  "version": "0.3.0-beta.28",
  "description": "Proteus 跨层共享 DTO 契约（架构规约 L0 + types-plan §07）：RouteRecord/RouteMeta/RouteTransition/ApiResponse/StoreSnapshot/CapabilityDescriptor——零运行时依赖纯类型，types 包 re-export 兼容（同名必同义，铁律 #9）",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js",
      "default": "./dist/layers.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.js",
      "default": "./dist/scroll.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    },
    "./env-vars": {
      "types": "./dist/env-vars.d.ts",
      "import": "./dist/env-vars.js",
      "default": "./dist/env-vars.js"
    },
    "./style-ir-values": {
      "types": "./dist/style-ir-values.d.ts",
      "import": "./dist/style-ir-values.js",
      "default": "./dist/style-ir-values.js"
    },
    "./style-applier": {
      "types": "./dist/style-applier.d.ts",
      "import": "./dist/style-applier.js",
      "default": "./dist/style-applier.js"
    },
    "./style-ir-canonical": {
      "types": "./dist/style-ir-canonical.d.ts",
      "import": "./dist/style-ir-canonical.js",
      "default": "./dist/style-ir-canonical.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts src/route.ts src/api.ts src/store.ts src/capability.ts src/style.ts src/layers.ts src/scroll.ts src/env-vars.ts src/style-ir-values.ts src/style-applier.ts src/style-ir-registry.generated.ts src/style-ir-canonical.ts --bundle --format=esm --platform=node --outdir=dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
