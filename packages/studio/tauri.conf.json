{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proteus-studio",
  "version": "0.1.0",
  "identifier": "dev.proteus.studio.shell",
  "build": {
    "frontendDist": "web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Proteus Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Proteus Studio",
    "longDescription": "Proteus 跨端调试器"
  }
}
