{
  "name": "@proteus-vue/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proteus 官网（dogfooding：用 Proteus 自身构建——@proteus-vue/docs 文档引擎 + @proteus-vue/fluid 柔性布局 + v-p-hover 桌面原语；W-6 柔性框架优先：响应式零 @media）",
  "scripts": {
    "dev": "pnpm exec proteus dev --target web",
    "build": "node scripts/gen-plugin-docs.mjs --check && pnpm exec proteus build --target web",
    "preview": "pnpm exec proteus build --target web && vite preview dist",
    "gen:content": "tsx scripts/gen-content.mjs",
    "gen:plugin-docs": "tsx scripts/gen-plugin-docs.mjs",
    "check:plugin-docs": "tsx scripts/gen-plugin-docs.mjs --check",
    "postinstall": "node ../scripts/build-packages.mjs",
    "gen:reference": "tsx scripts/gen-reference.mjs",
    "check:reference": "tsx scripts/gen-reference.mjs --check",
    "gen:css-compat": "tsx scripts/gen-css-compat.mjs",
    "check:css-compat": "tsx scripts/gen-css-compat.mjs --check"
  },
  "dependencies": {
    "@proteus-vue/compiler": "0.3.0-beta.0",
    "@proteus-vue/compiler-backend": "0.1.0",
    "@proteus-vue/desktop": "0.1.0",
    "@proteus-vue/docs": "0.1.0",
    "miniprogram-api-typings": "^3.12.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "@proteus-vue/fluid": "0.1.0",
    "@proteus-vue/gesture": "0.1.0",
    "@proteus-vue/devtools-runtime": "0.1.0",
    "@proteus-vue/render-backend": "0.1.0",
    "@proteus-vue/test-ir": "0.1.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "@types/three": "^0.160.0",
    "@proteus-vue/cli": "0.2.1-beta.0",
    "@proteus-vue/plugin-vite": "0.2.0-beta.0"
  }
}