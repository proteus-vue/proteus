{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@proteus-vue/components": ["../src/components/index.ts"],
      "@proteus-vue/components/*": ["../src/components/*"],
      "@proteus-vue/shared": ["../packages/shared/src/index.ts"],
      "@proteus-vue/glass": ["../packages/glass/src/index.ts"],
      "@proteus-vue/worklet": ["../packages/worklet/src/index.ts"],
      "@proteus-vue/api": ["../packages/api/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "src/env.d.ts"]
}
