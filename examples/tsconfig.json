{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "./shims/mp.d.ts", "./shims/events.d.ts", "./shims/vue.d.ts"],
    "baseUrl": ".",
    "paths": {
      "@proteus-vue/components": ["../src/components/index.ts"],
      "@proteus-vue/components/*": ["../src/components/*"],
      // ★@proteus-vue/shared：框架组件（src/components）经 L2 抽象消费——根 node_modules 未 hoist shared
      //   （fluid/devtools-runtime 在 root node_modules，shared 只在 examples）→ 显式 paths 解析到源码
      "@proteus-vue/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "pages/**/*.vue",
    "router/**/*.ts",
    "router/**/*.vue",
    "stores/**/*.ts",
    "components/**/*.vue",
    "ssr/**/*.ts",
    "main.ts",
    "main.mp.ts",
    "App.vue",
    "shims/**/*.d.ts",
    "../src/components/**/*.d.ts",
    "vite.config.ts",
    "proteus.config.ts"
  ],
  "exclude": ["node_modules", "dist", "migration-from-vue"]
}
