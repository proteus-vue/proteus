{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "./shims/mp.d.ts", "./shims/events.d.ts", "./shims/vue.d.ts"],
    "baseUrl": ".",
    "paths": {
      "@proteus/components": ["../src/components/index.ts"],
      "@proteus/components/*": ["../src/components/*"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "pages/**/*.vue",
    "router/**/*.ts",
    "router/**/*.vue",
    "stores/**/*.ts",
    "components/**/*.vue",
    "ssr/**/*.ts",
    "main.ts",
    "main.mp.ts",
    "App.vue",
    "shims/**/*.d.ts",
    "vite.config.ts",
    "proteus.config.ts"
  ],
  "exclude": ["node_modules", "dist", "migration-from-vue"]
}
