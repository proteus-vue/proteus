{
  "name": "proteus-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proteus 示例工程：一份标准 Vue 源码 → Web + 微信小程序（Skyline）——完整工程形态（配置自包含）",
  "scripts": {
    "dev:web": "proteus dev --target web",
    "build:web": "proteus build --target web",
    "dev:mp": "tsx scripts/dev-mp.ts",
    "build:mp": "proteus build --target skyline && tsx scripts/bundle-report.ts",
    "debug:mp": "PROTEUS_DEBUG=1 proteus build --target skyline",
    "preview:web": "proteus build --target web && vite preview dist/web",
    "router:check": "tsx ../packages/cli/src/index.ts router:check pages",
    "cli:check": "tsx ../packages/cli/src/index.ts check",
    "cli:css-check": "tsx ../packages/cli/src/index.ts css:check .",
    "cli:style-check": "tsx ../packages/cli/src/index.ts style:check .",
    "cli:config-check": "tsx ../packages/cli/src/index.ts config:check proteus.config.ts",
    "cli:build:web": "tsx ../packages/cli/src/index.ts build --target web",
    "cli:build:mp": "tsx ../packages/cli/src/index.ts build --target skyline",
    "cli:dev": "tsx ../packages/cli/src/index.ts dev --target web",
    "cli:help": "tsx ../packages/cli/src/index.ts help"
  },
  "dependencies": {
    "@proteus-vue/api": "0.1.0",
    "@proteus-vue/app-config": "0.1.0",
    "@proteus-vue/built-in-components": "0.1.0",
    "@proteus-vue/capabilities": "0.1.0",
    "@proteus-vue/compat-miniprogram": "0.1.0",
    "@proteus-vue/desktop": "0.1.0",
    "@proteus-vue/dev-host": "0.1.0",
    "@proteus-vue/devtools": "0.1.0",
    "@proteus-vue/devtools-runtime": "0.1.0",
    "@proteus-vue/docs": "0.1.0",
    "@proteus-vue/fluid": "0.1.0",
    "@proteus-vue/gesture": "0.1.0",
    "@proteus-vue/i18n": "0.1.0",
    "@proteus-vue/module": "0.1.0",
    "@proteus-vue/render-backend": "0.1.0",
    "@proteus-vue/router": "0.2.0-beta.0",
    "@proteus-vue/runtime": "0.2.0-beta.0",
    "@proteus-vue/shared": "0.2.0-beta.0",
    "@proteus-vue/style-safety": "0.1.0",
    "@proteus-vue/test-ir": "0.1.0",
    "@proteus-vue/web": "0.1.0",
    "@vue/devtools-api": "^8.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@proteus-vue/cli": "0.2.1-beta.0",
    "@proteus-vue/compiler": "0.3.0-beta.0",
    "@proteus-vue/plugin-vite": "0.2.0-beta.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "@proteus-vue/hmr": "0.1.0"
  }
}