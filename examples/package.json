{
  "name": "proteus-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proteus 示例工程：一份标准 Vue 源码 → Web + 微信小程序（Skyline）——完整工程形态（配置自包含）",
  "scripts": {
    "dev:web": "vite --mode web",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "dev:mp": "tsx scripts/dev-mp.ts",
    "build:mp": "tsx scripts/gen-routes.ts && vue-tsc --noEmit && vite build --mode mp-weixin && tsx scripts/bundle-report.ts",
    "debug:mp": "PROTEUS_DEBUG=1 npm run build:mp",
    "preview:web": "vite preview --mode web",
    "router:check": "tsx ../packages/cli/src/index.ts router:check pages",
    "cli:check": "tsx ../packages/cli/src/index.ts check",
    "cli:css-check": "tsx ../packages/cli/src/index.ts css:check .",
    "cli:style-check": "tsx ../packages/cli/src/index.ts style:check .",
    "cli:config-check": "tsx ../packages/cli/src/index.ts config:check proteus.config.ts",
    "cli:build:web": "tsx ../packages/cli/src/index.ts build --target web",
    "cli:build:mp": "tsx ../packages/cli/src/index.ts build --target skyline",
    "cli:dev": "tsx ../packages/cli/src/index.ts dev --target web",
    "cli:help": "tsx ../packages/cli/src/index.ts help"
  },
  "dependencies": {
    "@proteus-vue/api": "workspace:*",
    "@proteus-vue/app-config": "workspace:*",
    "@proteus-vue/built-in-components": "workspace:*",
    "@proteus-vue/capabilities": "workspace:*",
    "@proteus-vue/compat-miniprogram": "workspace:*",
    "@proteus-vue/desktop": "workspace:*",
    "@proteus-vue/dev-host": "workspace:*",
    "@proteus-vue/devtools": "workspace:*",
    "@proteus-vue/devtools-runtime": "workspace:*",
    "@proteus-vue/docs": "workspace:*",
    "@proteus-vue/fluid": "workspace:*",
    "@proteus-vue/gesture": "workspace:*",
    "@proteus-vue/i18n": "workspace:*",
    "@proteus-vue/module": "workspace:*",
    "@proteus-vue/render-backend": "workspace:*",
    "@proteus-vue/router": "workspace:*",
    "@proteus-vue/runtime": "workspace:*",
    "@proteus-vue/shared": "workspace:*",
    "@proteus-vue/style-safety": "workspace:*",
    "@proteus-vue/test-ir": "workspace:*",
    "@proteus-vue/web": "workspace:*",
    "@vue/devtools-api": "^8.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@proteus-vue/cli": "workspace:*",
    "@proteus-vue/compiler": "workspace:*",
    "@proteus-vue/plugin-vite": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0"
  }
}
