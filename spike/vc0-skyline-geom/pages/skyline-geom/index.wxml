<!-- VC0 · Skyline 页：4 类节点（页面直挂）+ 一个探针组件 -->
<view class="page-root">
  <view id="g-view" class="probe-box" data-role="box"></view>
  <text id="g-text" class="probe-text">page-text</text>
  <image id="g-image" class="probe-image" src="/assets/dot.png"></image>
  <scroll-view id="g-scroll" class="probe-scroll" scroll-y>
    <view style="height:400px;width:120px;background-color:#445"></view>
  </scroll-view>
  <geom-probe tag="p1"></geom-probe>
</view>
<!-- ★L2.6 连续交互夹具：可滚动容器（Skyline 页面本身不滚动——见 skyline-pitfalls S14） -->
<scroll-view id="l26-scroll" scroll-y style="height:320px" scroll-top="{{scrollTop}}">
  <css-probe id="cssprobe" tag="p1"></css-probe>
</scroll-view>
