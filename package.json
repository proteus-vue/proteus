{
  "name": "proteus-vue",
  "version": "0.1.0",
  "description": "Proteus：Vue 跨端编译框架（小程序 Skyline + Web）—— 一份 Vue 源码，编译器化作千端形态",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/proteus-vue/proteus.git"
  },
  "homepage": "https://github.com/proteus-vue/proteus",
  "bugs": {
    "url": "https://github.com/proteus-vue/proteus/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/build-packages.mjs",
    "dev:web": "pnpm --filter proteus-examples dev:web",
    "build:web": "pnpm --filter proteus-examples build:web",
    "dev:mp": "pnpm --filter proteus-examples dev:mp",
    "build:mp": "pnpm --filter proteus-examples build:mp",
    "debug:mp": "pnpm --filter proteus-examples debug:mp",
    "preview:web": "pnpm --filter proteus-examples preview:web",
    "proteus": "tsx packages/cli/src/index.ts",
    "cli:build": "pnpm --filter @proteus-vue/cli build",
    "create": "tsx packages/create-proteus/src/index.ts",
    "create:build": "pnpm --filter @proteus-vue/create-proteus build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "verify": "pnpm run test && pnpm run build:web && pnpm run build:mp && pnpm -r build && pnpm run check:pkg && pnpm run check:deps",
    "check:pkg": "node scripts/check-package-health.js",
    "bench": "tsx scripts/benchmark.ts",
    "bench:update": "tsx scripts/benchmark.ts --update",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "test": "vitest run --exclude \"tests/e2e-*.test.ts\"",
    "test:e2e:web": "npm run build:web && vitest run --no-file-parallelism tests/e2e-web.test.ts tests/e2e-web-keypaths.test.ts tests/e2e-render-backend-demo.test.ts",
    "test:update": "vitest run -u --exclude \"tests/e2e-*.test.ts\"",
    "dev:website": "pnpm --filter website dev",
    "build:website": "pnpm --filter website build",
    "preview:website": "pnpm --filter website preview",
    "check:alltarget": "node scripts/check-all-target-wording.mjs",
    "audit:website": "tsx packages/cli/src/index.ts audit d2 website/src",
    "check:live": "node website/scripts/verify-live.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@proteus-vue/devtools-runtime": "workspace:*",
    "@proteus-vue/fluid": "workspace:*",
    "@proteus-vue/gesture": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.12.0",
    "jsdom": "^27.0.1",
    "miniprogram-api-typings": "^5.2.3",
    "miniprogram-automator": "^0.12.1",
    "playwright": "^1.48.2",
    "sass": "^1.103.1",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^2.0.0",
    "ws": "^8.18.0",
    "@proteus-vue/cli": "0.2.1-beta.0"
  },
  "packageManager": "pnpm@9.15.9"
}