{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // ★T-app-fetch（2026-10-18）：C26 useFetch 的宿主 HTTP 腿需要联网权限。
    //   Android 侧已双变体加 INTERNET（决策 #902）；鸿蒙此前无任何网络能力 ⇒ 从未声明过。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      // ★★★C16 权限状态查询（`permission.check`）：鸿蒙 `checkAccessTokenSync` 对**未声明**的权限
      //   同样回 PERMISSION_DENIED ⇒ 不声明会让"清单没配"与"用户拒绝"看起来完全一样
      //   （Android 侧用 `declared` 位区分，鸿蒙这边直接按"本宿主会用到"声明三项）。
      //   ★user_grant 类权限：声明了只是"有资格申请"，**申请**仍要业务在真正使用时触发。
      //   本能力只查询状态，不申请（见 proteus_device.h 的 permission.check 注释）。
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:permission_camera_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:permission_microphone_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:permission_location_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/shell/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ]
  }
}
