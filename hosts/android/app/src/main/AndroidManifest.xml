<?xml version="1.0" encoding="utf-8"?>
<!-- hosts/android/app/src/main/AndroidManifest.xml —— M2 真机验证宿主 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.proteus.layoutcore">
    <application
        android:label="Proteus LayoutCore"
        android:debuggable="true"
        android:allowBackup="false"
        android:hasCode="true">
        <!-- ★★MainActivity = 验收装置（承载全部既有脚本：`am start -n .MainActivity` + `path` extra）。
             ★★2026-10-05（批次 44）：**launcher 入口移到 .SuperappActivity**（图标点开即 superapp 真实
             应用，不再是"运行 4050 测试"按钮页）。MainActivity 保留 exported=true（脚本走显式组件
             启动，不依赖 launcher 归属）——既有脚本零改动（仅 launcher 触发从 monkey 换成显式 start）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- ★★★批次 44：**superapp 真实应用**桌面图标入口（点开即见 superapp，可切 tab）。
             取景/全屏由运行时设置（FLAG_FULLSCREEN + setDecorFitsSystemWindows(false)），与 L4/StressSfc 同款。 -->
        <activity
            android:name=".SuperappActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ★★L4 观测夹具（独立 Activity · 2026-10-02）：Manifest 声明全屏主题 ⇒ 冷启动即无
             「状态栏 + ActionBar」，与其它四端（Web/小程序/iOS）取景对齐。
             用户反馈「安卓看着整体位置偏下」的真因就是这两道系统栏（312px）；运行时隐藏
             （setDecorFitsSystemWindows/hide）会引入重排与截图竞态（实测：过校正到 7.4% +
             首帧截图仍是旧 chrome），⇒ 用声明式主题（零重排）。本 Activity 无 launcher 入口。 -->
        <!-- ★exported 必须 true：采集脚本用 `adb shell am start` 启动它，而 adb shell 是
             external uid（uid 2000）——exported=false 会被 ActivityTaskSupervisor 拒
             （实测：Permission Denial ... not exported from uid 10703）。
             无 launcher intent-filter ⇒ 用户桌面看不到入口，仅脚本可达。 -->
        <activity
            android:name=".L4Activity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- ★★★六端 SFC 压力夹具（2026-10-02）：渲染 examples/pages/consistency-stress.vue 的
             编译产物（与 L4Activity 的区别：L4 画手写 Cmd，本 Activity 画 SFC 编译产物）。
             全屏主题同 L4Activity（取景对齐是六端像素比较的前提）。exported=true（adb 可达）。 -->
        <activity
            android:name=".StressSfcActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode" />
    </application>
</manifest>
