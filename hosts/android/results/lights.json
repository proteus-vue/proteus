s":0,"duration_ms":1411,"note":"光幕扫描：暗带自上而下压过、亮带随即扫回（整行同拍、行间 30ms）——\"灯光窗帘\""},{"name":"fan","anims":3200,"color_anims":3200,"issue_ms":100.87,"span_ms":1950,"hold_ms":0,"duration_ms":1950,"note":"旋转光扇：60° 光束绕屏心旋转一周（12 步 × 150ms）——被照到的灯亮白、扫过即灭"},{"name":"checker","anims":3200,"color_anims":3200,"issue_ms":113.75,"span_ms":1440,"hold_ms":0,"duration_ms":1440,"note":"棋盘翻转：灯按 (行+列) 奇偶亮灭成棋盘格，整体翻转 5 次后收为全灭"},{"name":"sparkle","anims":3200,"color_anims":3200,"issue_ms":127.17,"span_ms":1400,"hold_ms":0,"duration_ms":1400,"note":"星火：800 颗灯按确定性伪随机闪烁霓虹色（6 段/灯）——满屏灯在闪"},{"name":"matrix800","anims":3200,"color_anims":3200,"issue_ms":52.3,"span_ms":4415,"hold_ms":0,"duration_ms":4415,"note":"灯阵点字：亮灯按对角波形**逐颗写**成「800」（灭灯仍是暗盘）——文字完全靠亮灭完成"},{"name":"matrixLIGHTS","anims":3200,"color_anims":3200,"issue_ms":39.15,"span_ms":4475,"hold_ms":0,"duration_ms":4475,"note":"灯阵点字：旧图案随对角波**溶解**、新文字「LIG/HTS」（= LIGHTS）随之浮现——逐灯从真实当前色出发"},{"name":"blackout","anims":3200,"color_anims":3200,"issue_ms":64.57,"span_ms":739.65,"hold_ms":0,"duration_ms":739.65,"note":"熄灯：亮盘从中心向外逐圈暗下（暗盘保持不动）——\"灭灯\"，灯一颗不消失"},{"name":"finale","anims":3200,"color_anims":3200,"issue_ms":96.01,"span_ms":2318,"hold_ms":0,"duration_ms":2318,"note":"全场亮灯：从中心向外逐圈亮起（暗盘 → 白）——谢幕高潮"},{"name":"curtain","anims":3200,"color_anims":3200,"issue_ms":63.47,"span_ms":1119.6,"hold_ms":0,"duration_ms":1119.6,"note":"谢幕熄灯：全场熄灭（白 → 暗盘）——回到全灭但全可见，可无缝循环"}],"acts_complete":true,"acts_host_match":true,"escapes":{"total":0,"declaratives":48004,"byKind":{"custom-easing":0,"external-driver":0,"layout-property":0,"cross-property-timeline":0,"platform-mixing":0,"other":0},"degraded":[],"ratio":0},"opacity_anims":0,"opacity_min_to":1,"color_anims_total":48004,"non_color_anims":0}